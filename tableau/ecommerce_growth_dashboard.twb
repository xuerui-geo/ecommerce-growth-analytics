    <worksheet name='Conversion rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Conversion rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Weekly KPIs' name='federated.weekly' />
          </datasources>
          <datasource-dependencies datasource='federated.weekly'>
            <column caption='Conversion rate (buyers / UV)' datatype='real' default-format='p0.0%' name='[Calculation_1001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([buyers]) / SUM([uv])' />
            </column>
            <column datatype='integer' name='[buyers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[uv]' role='measure' type='quantitative' />
            <column datatype='date' name='[week]' role='dimension' type='ordinal' />
            <column-instance column='[week]' derivation='Day-Trunc' name='[tdy:week:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1001]' derivation='User' name='[usr:Calculation_1001:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
