  <dashboards>
    <dashboard name='1 Store KPIs'>
      <style />
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='108' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='100000' id='107' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'><zone h='9000' id='100' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='16'>Store KPIs - Feb to Nov 2023</run><run>Æ&#10;</run><run fontcolor='#52514e' fontsize='10'>Weekly traffic, conversion and revenue. Spikes = 618 (June) and Singles' Day (Oct 24-Nov 11) sales. Synthetic data.</run></formatted-text></zone><zone h='45500' id='103' param='horz' type-v2='layout-flow' w='100000' x='0' y='9000'><zone h='45500' id='101' name='Weekly GMV (CNY)' w='50000' x='0' y='9000' /><zone h='45500' id='102' name='Weekly unique visitors' w='50000' x='50000' y='9000' /></zone><zone h='45500' id='106' param='horz' type-v2='layout-flow' w='100000' x='0' y='54500'><zone h='45500' id='104' name='Conversion rate' w='50000' x='0' y='54500' /><zone h='45500' id='105' name='Average order value' w='50000' x='50000' y='54500' /></zone></zone></zone>
      </zones>
    </dashboard>
    <dashboard name='2 Campaign Diagnostics'>
      <style />
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='120' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='100000' id='119' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'><zone h='9000' id='109' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='16'>Paid Campaign Diagnostics - the July C03 incident</run><run>Æ&#10;</run><run fontcolor='#52514e' fontsize='10'>C03 targeting drifted to 18-24 / Tier 3-4+ on Jul 12-30 (Before = Jun 19-Jul 11): CTR 3.35% to 2.06%, ROAS 5.6 to 3.4, about CNY 47K GMV lost. 97% of the CTR drop is an audience-mix effect.</run></formatted-text></zone><zone h='45500' id='114' param='horz' type-v2='layout-flow' w='100000' x='0' y='9000'><zone h='45500' id='110' name='ROAS by campaign' w='40000' x='0' y='9000' /><zone h='45500' id='113' param='vert' type-v2='layout-flow' w='60000' x='40000' y='9000'><zone h='22750' id='111' name='C03 Visitor Retargeting - daily CTR' w='60000' x='40000' y='9000' /><zone h='22750' id='112' name='C03 Visitor Retargeting - daily ROAS' w='60000' x='40000' y='31750' /></zone></zone><zone h='45500' id='118' param='horz' type-v2='layout-flow' w='100000' x='0' y='54500'><zone h='45500' id='115' name='C03 impression share by age: before vs incident' w='37000' x='0' y='54500' /><zone h='45500' id='116' name='C03 impression share by city tier' w='33000' x='37000' y='54500' /><zone h='45500' id='117' name='What explains the CTR drop? (CTR points)' w='30000' x='70000' y='54500' /></zone></zone></zone>
      </zones>
    </dashboard>
    <dashboard name='3 Segments and Coupon Test'>
      <style />
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='130' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='100000' id='129' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'><zone h='9000' id='121' type-v2='text' w='100000' x='0' y='0'><formatted-text><run bold='true' fontsize='16'>Customer Segments and Coupon Program A/B Test</run><run>Æ&#10;</run><run fontcolor='#52514e' fontsize='10'>K-means found 5 segments; Deal Seekers + New Potential got coupons from Sep 1 with a random 20% holdout. Orders per customer +49% (95% CI +37% to +63%).</run></formatted-text></zone><zone h='45500' id='124' param='horz' type-v2='layout-flow' w='100000' x='0' y='9000'><zone h='45500' id='122' name='Segment size vs revenue share' w='50000' x='0' y='9000' /><zone h='45500' id='123' name='Segment profile &amp;amp; action' w='50000' x='50000' y='9000' /></zone><zone h='45500' id='128' param='horz' type-v2='layout-flow' w='100000' x='0' y='54500'><zone h='45500' id='125' name='Weekly orders per 100 targeted customers' w='50000' x='0' y='54500' /><zone h='45500' id='126' name='Orders per customer, Sep-Nov (+49%)' w='25000' x='50000' y='54500' /><zone h='45500' id='127' name='Net GMV per customer, Sep-Nov' w='25000' x='75000' y='54500' /></zone></zone></zone>
      </zones>
