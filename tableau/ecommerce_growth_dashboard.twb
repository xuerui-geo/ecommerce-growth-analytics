            <column-instance column='[week]' derivation='Day-Trunc' name='[tdy:week:qk]' pivot='key' type='quantitative' />
            <column-instance column='[gmv]' derivation='Sum' name='[sum:gmv:qk]' pivot='key' type='quantitative' />
